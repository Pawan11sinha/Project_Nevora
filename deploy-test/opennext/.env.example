# Template for .dev.vars, which `npm run preview` reads. Never commit real values.
#
# Don't use .env, .env.local or .env.production for these: OpenNext compiles those files
# into the Worker bundle, so a later deploy would upload their values.
#
# In a deployed Worker, set these with: npx wrangler secret put <NAME>

# Supabase Project URL
SUPABASE_URL=

# Supabase publishable key. Never put the secret or service_role key here.
SUPABASE_PUBLISHABLE_KEY=

# Optional. Any long random string, used only by the test route /api/db-test
DEPLOY_TEST_TOKEN=

# Required on any deployment with the access gate. With no value, every Worker route returns 404,
# locally too. Send it as the x-test-gate-token header. At least 32 random characters.
TEST_GATE_TOKEN=

# Leave unset for tests. Only "1" allows the signup page to create accounts.
SIGNUP_ENABLED=
