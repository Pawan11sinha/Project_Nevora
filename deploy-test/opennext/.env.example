# Copy to .dev.vars for local Worker runs. Never commit real values.
# In a deployed Worker, set these with: npx wrangler secret put <NAME>
#
# All are optional for the deployment test. Without them, protected pages redirect to login.

# Supabase Project URL
SUPABASE_URL=

# Supabase publishable key. Never put the secret or service_role key here.
SUPABASE_PUBLISHABLE_KEY=

# Any long random string, used only by the test route /api/db-test
DEPLOY_TEST_TOKEN=
