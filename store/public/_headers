# Headers for static files served by Cloudflare Workers Static Assets, which never run the Worker.
# Cloudflare reads this file and doesn't serve it. Pages generated by the Worker get their headers from next.config.ts.
# Keep the shared values here in step with next.config.ts. X-Robots-Tag is removed deliberately at public launch.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  X-Robots-Tag: noindex, nofollow

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Versioned by PIN_DATA_VERSION in src/lib/pincode.ts. The build script refuses to change an existing version.
/data/pin/v1/*
  Cache-Control: public, max-age=31536000, immutable

/data/pin/v1/NOTICE.txt
  Content-Type: text/plain; charset=utf-8

/sample/*
  Cache-Control: public, max-age=86400
