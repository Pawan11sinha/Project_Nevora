# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Local Worker secrets (CLAUDE.md): never committed. Production secrets use `wrangler secret`.
.dev.vars*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local prototype screenshots
/screenshots/

# Local Supabase CLI and native runtime state, never committed
/.supabase-home/
/.supabase/

# Supabase CLI credentials, project link and temporary files, never committed
/supabase/signing_keys.json
/supabase/.link.json
/supabase/.link.json.*.tmp
/supabase/.supabase.lock.*.tmp
/supabase/.supabase.lock.lease
